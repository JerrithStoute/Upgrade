model FileAsset {
  id                String           @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId         String           @default(dbgenerated("current_setting('app.company_id'::text)"))
  projectId         String
  project           Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
