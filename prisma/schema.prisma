// Upgrade — Construction Project Management
// Data model covering projects, clients, estimates, selections, change orders,
// scheduling, budgets/job costing, invoicing, daily logs, to-dos, files, messaging
// and plan takeoffs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Company & users
// ---------------------------------------------------------------------------

model Company {
  id                  String   @id @default(cuid())
  name                String
  address             String?
  city                String?
  state               String?
  zip                 String?
  phone               String?
  email               String?
  website             String?
  licenseNumber       String?
  defaultMarkup       Float    @default(20) // percent
  // Branding: the main color ("#1d4ed8"; null = the built-in blue) and the logo file
  // (under uploads/company; null = none).
  brandColor          String?
  logoPath            String?
  logoType            String?
  // What proposals show by default (JSON, see src/lib/proposal-options.ts); null = the built-in default.
  proposalOptions     String?
  // New allowances start with profit in (true) or out (false, at cost); each can be switched.
  allowanceProfit     Boolean  @default(false)
  // Change order defaults ("Use as default"): JSON { introText, closingText, terms, ifDeclined, profitMode, profitValue, profitShown }.
  changeOrderDefaults String?
  // Your default Markup, Margin & Tax table for new estimates (JSON).
  markupTable         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

/// ADMIN: full access. STAFF: internal team. CLIENT: portal only. SUB: subcontractor (limited).
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("STAFF") // ADMIN | STAFF | CLIENT | SUB
  phone        String?
  title        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client          Client?
  managedProjects Project[]      @relation("ProjectManager")
  assignedTasks   ScheduleTask[] @relation("TaskAssignee")
  assignedTodos   Todo[]         @relation("TodoAssignee")
  createdTodos    Todo[]         @relation("TodoCreator")
  dailyLogs       DailyLog[]
  uploadedFiles   FileAsset[]
  fileViews       FileView[]
  messages        Message[]
  activities      Activity[]
  expenses        Expense[]
}

// ---------------------------------------------------------------------------
// Clients (CRM)
// ---------------------------------------------------------------------------

model Client {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  company   String?
  email     String?
  phone     String?
  address   String?
  city      String?
  state     String?
  zip       String?
  notes     String?
  source    String? // referral, website, etc.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  projects Project[]
}

// ---------------------------------------------------------------------------
// Projects
// ---------------------------------------------------------------------------

/// status: LEAD | ESTIMATING | PROPOSAL_SENT | CONTRACTED | IN_PROGRESS | ON_HOLD | COMPLETED | CANCELLED
/// type: NEW_HOME | REMODEL | ADDITION | COMMERCIAL | OTHER
model Project {
  id             String    @id @default(cuid())
  number         Int       @unique
  name           String
  status         String    @default("LEAD")
  type           String    @default("REMODEL")
  description    String?
  address        String?
  city           String?
  state          String?
  zip            String?
  squareFeet     Int?
  startDate      DateTime?
  targetEndDate  DateTime?
  actualEndDate  DateTime?
  contractAmount Float     @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  managerId String?
  manager   User?   @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)

  // The proposal's cover picture (under uploads/projects; PNG, JPG or WebP); null = none.
  coverPath         String?
  coverType         String?
  // Prices locked on this job (set when an estimate is marked sent, or by hand): the Item
  // List no longer changes it. null = the job follows the Item List (except pinned items).
  pricesLockedAt    DateTime?
  estimates         Estimate[]
  parameterValues   ProjectParameterValue[]
  selections        Selection[]
  changeOrders      ChangeOrder[]
  tasks             ScheduleTask[]
  expenses          Expense[]
  invoices          Invoice[]
  dailyLogs         DailyLog[]
  todos             Todo[]
  files             FileAsset[]
  threads           MessageThread[]
  activities        Activity[]
  takeoffPlans      TakeoffPlan[]
  takeoffConditions TakeoffCondition[]
  bids              Bid[]
  bidAwards         BidAward[]
}

// ---------------------------------------------------------------------------
// Cost codes (used across estimates, change orders, expenses, budget)
// ---------------------------------------------------------------------------

model CostCode {
  id        String   @id @default(cuid())
  code      String?  @unique // e.g. "03-100" — optional; some codes are name-only
  name      String // e.g. "Concrete Foundation"
  division  String // group, e.g. "03 Concrete"
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  estimateItems             EstimateItem[]
  templateItems             EstimateTemplateItem[]
  changeOrderItems          ChangeOrderItem[]
  expenses                  Expense[]
  selections                Selection[]
  takeoffConditions         TakeoffCondition[]
  takeoffItems              TakeoffAssemblyItem[]
  materialItems             MaterialItem[]
  takeoffTemplateConditions TakeoffTemplateCondition[]
  takeoffTemplateItems      TakeoffTemplateItem[]
  itemCodeRules             ItemCodeRule[]
}

// ---------------------------------------------------------------------------
// Estimates & proposals
// ---------------------------------------------------------------------------

/// status: DRAFT | SENT | APPROVED | DECLINED
model Estimate {
  id              String    @id @default(cuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name            String    @default("Estimate")
  version         Int       @default(1)
  status          String    @default("DRAFT")
  notes           String? // shown on proposal
  terms           String?
  defaultMarkup   Float     @default(20)
  // The number actually quoted to the client (goes on the proposal); the line total is what it adds up to.
  basePrice       Float?
  totalSqFt       Float?
  // This estimate's proposal options (JSON); null = the company default.
  proposalOptions String?
  // Markup, Margin & Tax table (JSON rows, see src/lib/markup.ts); null = one profit row at defaultMarkup.
  markupTable     String?
  sentAt          DateTime?
  approvedAt      DateTime?
  // Locked by hand: no automatic updates from the takeoff, no edits, until unlocked.
  lockedAt        DateTime?
  // "What changed": automatic updates from the takeoff since the last save (JSON, see takeoff-changes.ts).
  autoNote        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  items           EstimateItem[]
  specs           EstimateSpec[]
  parameterValues EstimateParameterValue[]
}

/// A spec item: one thing the client is buying ("Hardwood flooring — main level"),
/// filed under a category and priced by its cost lines (each with its own cost code).
/// The client sees the spec text and one amount; job costing tracks every line.
/// An allowance spec's amount is what the client's selection is measured against.
/// kind: SPECIFICATION | SELECTION
model EstimateSpec {
  id              String     @id @default(cuid())
  estimateId      String
  estimate        Estimate   @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  name            String
  category        String     @default("General") @map("group")
  specText        String?    @map("description") // what is included — for clients and trades
  kind            String     @default("SPECIFICATION")
  isAllowance     Boolean    @default(false)
  clientNotes     String?
  tradeNotes      String?
  urgent          Boolean    @default(false)
  requestedBy     DateTime?
  selectionId     String? // selection whose allowance this amount feeds
  selection       Selection? @relation(fields: [selectionId], references: [id], onDelete: SetNull)
  // This item on the proposal, overriding the estimate's options (JSON {show, prices, items}); null = follow them.
  proposalView    String?
  // Allowance amount with profit in (true) or at cost (false); null = the company default.
  allowanceProfit Boolean?
  sortOrder       Int        @default(0)
  createdAt       DateTime   @default(now())

  items EstimateItem[]

  @@map("EstimateAllowance")
}

/// costType: MATERIAL | LABOR | SUBCONTRACTOR | EQUIPMENT | OTHER. markupPct is the line's profit %.
model EstimateItem {
  id             String        @id @default(cuid())
  estimateId     String
  estimate       Estimate      @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  costCodeId     String?
  costCode       CostCode?     @relation(fields: [costCodeId], references: [id], onDelete: SetNull)
  group          String        @default("General") // section heading on proposal
  description    String
  quantity       Float         @default(1)
  unit           String        @default("ea")
  unitCost       Float         @default(0)
  markupPct      Float         @default(20)
  isAllowance    Boolean       @default(false) // copied from its spec item
  isOptional     Boolean       @default(false)
  costType       String        @default("MATERIAL")
  notes          String?
  // Quantity from the job's estimate parameters ("[#id] * 1.1"); null = typed in.
  qtyFormula     String?
  // Unit cost from the job's estimate parameters, the same way; null = typed in.
  costFormula    String?
  sortOrder      Int           @default(0)
  specId         String?       @map("allowanceId")
  spec           EstimateSpec? @relation(fields: [specId], references: [id], onDelete: SetNull)
  // Item List item this line was added to / priced from ("Stop updating" clears it).
  materialItemId String?
  materialItem   MaterialItem? @relation(fields: [materialItemId], references: [id], onDelete: SetNull)

  // The takeoff's total for one cost code ("code:<id>", or "group:<name>" with no code):
  // sending the takeoff again updates this one line; the material detail stays in the Material list.
  takeoffRollup      String?
  // The takeoff items behind it at the last update (JSON rows) — what "what changed" compares with.
  takeoffSnapshot    String?
  // Older estimates: one line per takeoff item (merged into the rolled-up line on the next send).
  takeoffConditionId String?
  takeoffCondition   TakeoffCondition?    @relation(fields: [takeoffConditionId], references: [id], onDelete: SetNull)
  takeoffItemId      String?
  takeoffItem        TakeoffAssemblyItem? @relation(fields: [takeoffItemId], references: [id], onDelete: SetNull)
}

/// Your estimate categories (Settings → Estimate categories): big groups such as
/// "Excavation and Foundation" that hold cost code divisions. A division's spec item
/// files itself into its category.
model EstimateCategory {
  id        String                     @id @default(cuid())
  name      String                     @unique
  sortOrder Int                        @default(0)
  divisions EstimateCategoryDivision[]
}

model EstimateCategoryDivision {
  id         String           @id @default(cuid())
  categoryId String
  category   EstimateCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  division   String           @unique // a CostCode.division, e.g. "2100 Footing and Foundation"
  sortOrder  Int              @default(0)
}

/// Your estimate parameters (Settings → Estimate parameters): named job values such
/// as "Heated sq. ft." that item quantities use in formulas. One can be the job's
/// total sq. ft.
model EstimateParameter {
  id             String                   @id @default(cuid())
  name           String                   @unique
  unit           String                   @default("")
  sortOrder      Int                      @default(0)
  isSqFt         Boolean                  @default(false)
  values         ProjectParameterValue[]
  estimateValues EstimateParameterValue[]
}

/// An estimate version's value for a parameter. Each version has its own (v2 may be a
/// different set of plans): a new version starts blank (or with its template's values),
/// a copy of a version starts with that version's.
model EstimateParameterValue {
  id          String            @id @default(cuid())
  estimateId  String
  estimate    Estimate          @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  parameterId String
  parameter   EstimateParameter @relation(fields: [parameterId], references: [id], onDelete: Cascade)
  value       Float

  @@unique([estimateId, parameterId])
}

/// Old: a job's value for a parameter, shared by its versions. Replaced by
/// EstimateParameterValue (each version its own); kept only so nothing is lost.
model ProjectParameterValue {
  id          String            @id @default(cuid())
  projectId   String
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parameterId String
  parameter   EstimateParameter @relation(fields: [parameterId], references: [id], onDelete: Cascade)
  value       Float

  @@unique([projectId, parameterId])
}

// ---------------------------------------------------------------------------
// Estimate templates (admin-managed starting points, copied into job estimates)
// ---------------------------------------------------------------------------

model EstimateTemplate {
  id            String   @id @default(cuid())
  name          String
  description   String?
  notes         String? // copied to the estimate (shown on proposal)
  terms         String?
  defaultMarkup Float    @default(20)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Markup, Margin & Tax table copied into estimates made from this template (JSON).
  markupTable String?
  // Parameter values copied into estimates made from this template: JSON { parameterId: value }.
  paramValues String?

  items EstimateTemplateItem[]
  specs EstimateTemplateSpec[]
}

model EstimateTemplateSpec {
  id          String           @id @default(cuid())
  templateId  String
  template    EstimateTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name        String
  category    String           @default("General") @map("group")
  specText    String?          @map("description")
  kind        String           @default("SPECIFICATION")
  isAllowance Boolean          @default(false)
  clientNotes String?
  tradeNotes  String?
  sortOrder   Int              @default(0)

  items EstimateTemplateItem[]

  @@map("EstimateTemplateAllowance")
}

model EstimateTemplateItem {
  id          String                @id @default(cuid())
  templateId  String
  template    EstimateTemplate      @relation(fields: [templateId], references: [id], onDelete: Cascade)
  costCodeId  String?
  costCode    CostCode?             @relation(fields: [costCodeId], references: [id], onDelete: SetNull)
  group       String                @default("General")
  description String
  quantity    Float                 @default(1)
  unit        String                @default("ea")
  unitCost    Float                 @default(0)
  markupPct   Float                 @default(20)
  isAllowance Boolean               @default(false)
  isOptional  Boolean               @default(false)
  costType    String                @default("MATERIAL")
  notes       String?
  // Quantity from your estimate parameters ("[#id] * 1.1"); null = typed in.
  qtyFormula  String?
  // Unit cost from your estimate parameters, the same way; null = typed in.
  costFormula String?
  sortOrder   Int                   @default(0)
  specId      String?               @map("allowanceId")
  spec        EstimateTemplateSpec? @relation(fields: [specId], references: [id], onDelete: SetNull)
}

// ---------------------------------------------------------------------------
// Selections (client choices with allowances)
// ---------------------------------------------------------------------------

/// status: PENDING | CHOSEN | APPROVED | ORDERED | INSTALLED
model Selection {
  id             String        @id @default(cuid())
  projectId      String
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  costCodeId     String?
  costCode       CostCode?     @relation(fields: [costCodeId], references: [id], onDelete: SetNull)
  title          String
  category       String        @default("General") // Flooring, Plumbing Fixtures, etc.
  location       String? // Kitchen, Master Bath
  description    String?
  allowance      Float         @default(0)
  // "Requested by": a date, or a schedule item (leadDays before it starts). dueDate is
  // always the resolved date (kept in step with the schedule).
  dueDate        DateTime?
  scheduleTaskId String?
  scheduleTask   ScheduleTask? @relation(fields: [scheduleTaskId], references: [id], onDelete: SetNull)
  leadDays       Int           @default(0)
  status         String        @default("PENDING")
  chosenAt       DateTime?
  approvedAt     DateTime?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  chosenOptionId String?
  options        SelectionOption[]
  estimateSpecs  EstimateSpec[]

  // Last change (for the UPDATED flag): when, and by whom (a user id).
  changedAt        DateTime?
  changedById      String?
  comments         SelectionComment[]
  log              SelectionLog[]
  views            SelectionView[]
  files            FileAsset[]
  changeOrderItems ChangeOrderItem[]
}

/// A comment on a selection — the client and your team; "internal" = team only.
model SelectionComment {
  id          String    @id @default(cuid())
  selectionId String
  selection   Selection @relation(fields: [selectionId], references: [id], onDelete: Cascade)
  userId      String?
  authorName  String
  body        String
  internal    Boolean   @default(false)
  createdAt   DateTime  @default(now())
}

/// The selection's change log: who did what, when.
model SelectionLog {
  id          String    @id @default(cuid())
  selectionId String
  selection   Selection @relation(fields: [selectionId], references: [id], onDelete: Cascade)
  userId      String?
  who         String
  what        String
  createdAt   DateTime  @default(now())
}

/// When someone last looked at a selection (so it can show UPDATED after others change it).
model SelectionView {
  id          String    @id @default(cuid())
  selectionId String
  selection   Selection @relation(fields: [selectionId], references: [id], onDelete: Cascade)
  userId      String
  viewedAt    DateTime  @default(now())

  @@unique([selectionId, userId])
}

model SelectionOption {
  id            String      @id @default(cuid())
  selectionId   String
  selection     Selection   @relation(fields: [selectionId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  vendor        String?
  modelNumber   String?
  price         Float       @default(0) // what the client pays for this choice
  cost          Float? // what it costs you (staff only)
  imageUrl      String?
  isRecommended Boolean     @default(false)
  sortOrder     Int         @default(0)
  files         FileAsset[]
}

// ---------------------------------------------------------------------------
// Change orders
// ---------------------------------------------------------------------------

/// status: DRAFT | PENDING_APPROVAL | APPROVED | DECLINED | VOID
model ChangeOrder {
  id                 String    @id @default(cuid())
  projectId          String
  project            Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number             Int
  title              String
  description        String?
  reason             String?
  status             String    @default("DRAFT")
  // What the client sees: every item (true), or just the total (false) — and with the
  // items shown, their prices (true) or just the items and the total (false).
  showItems          Boolean   @default(true)
  showPrices         Boolean   @default(true)
  scheduleImpactDays Int       @default(0)
  sentAt             DateTime?
  decidedAt          DateTime?
  decidedBy          String? // name of approver
  decisionNote       String?
  // The document (CoConstruct-style): intro / closing text and terms.
  introText          String?
  closingText        String?
  terms              String?
  // Profit, your choice each time: NONE | PCT | AMOUNT, shown as its own line (LINE) or folded into the line prices (FOLDED).
  profitMode         String    @default("NONE")
  profitValue        Float     @default(0)
  profitLabel        String    @default("Builder's fee")
  profitShown        String    @default("LINE")
  taxPct             Float     @default(0)
  taxLabel           String    @default("Sales tax")
  priorCompletion    DateTime?
  newCompletion      DateTime?
  // Who must approve: team members (JSON array of user ids), and the client (true/false).
  approverIds        String?
  teamApprovals      String? // JSON { userId: ISO date }
  clientApproval     Boolean   @default(true)
  clientApprovedAt   DateTime?
  // If declined: KEEP the client's choices, or CLEAR them.
  ifDeclined         String    @default("KEEP")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  items ChangeOrderItem[]
  files FileAsset[]

  @@unique([projectId, number])
}

model ChangeOrderItem {
  id            String      @id @default(cuid())
  changeOrderId String
  changeOrder   ChangeOrder @relation(fields: [changeOrderId], references: [id], onDelete: Cascade)
  costCodeId    String?
  costCode      CostCode?   @relation(fields: [costCodeId], references: [id], onDelete: SetNull)
  description   String
  quantity      Float       @default(1)
  unit          String      @default("ea")
  unitCost      Float       @default(0)
  markupPct     Float       @default(20)
  // This line's own profit: CO (follows the change order's — the default), NONE, PCT or AMOUNT.
  profitMode    String      @default("CO")
  profitValue   Float       @default(0)
  sortOrder     Int         @default(0)
  // LINE (an item), CHARGE (an extra charge, e.g. a change order fee) or SELECTION
  // (a client choice: clientPrice − allowance = the difference, kept in unitCost).
  kind          String      @default("LINE")
  selectionId   String?
  selection     Selection?  @relation(fields: [selectionId], references: [id], onDelete: SetNull)
  category      String?
  choiceName    String?
  clientPrice   Float?
  allowance     Float?
}

// ---------------------------------------------------------------------------
// Schedule
// ---------------------------------------------------------------------------

model ScheduleTask {
  id              String         @id @default(cuid())
  projectId       String
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name            String
  phase           String         @default("General") // Pre-Construction, Framing, ...
  startDate       DateTime
  endDate         DateTime
  percentComplete Int            @default(0)
  isMilestone     Boolean        @default(false)
  color           String         @default("#2563eb")
  notes           String?
  sortOrder       Int            @default(0)
  assigneeId      String?
  assignee        User?          @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  predecessorId   String?
  predecessor     ScheduleTask?  @relation("TaskPredecessor", fields: [predecessorId], references: [id], onDelete: SetNull)
  successors      ScheduleTask[] @relation("TaskPredecessor")
  selections      Selection[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

// ---------------------------------------------------------------------------
// Job costing: expenses (actual costs)
// ---------------------------------------------------------------------------

/// category: MATERIAL | LABOR | SUBCONTRACTOR | EQUIPMENT | PERMIT | OTHER
/// status: UNPAID | PAID
model Expense {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  costCodeId  String?
  costCode    CostCode? @relation(fields: [costCodeId], references: [id], onDelete: SetNull)
  date        DateTime  @default(now())
  vendor      String
  description String?
  category    String    @default("MATERIAL")
  amount      Float
  status      String    @default("UNPAID")
  reference   String? // vendor invoice #
  enteredById String?
  enteredBy   User?     @relation(fields: [enteredById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// Invoicing
// ---------------------------------------------------------------------------

/// status: DRAFT | SENT | PARTIAL | PAID | VOID
model Invoice {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number    Int       @unique
  title     String    @default("Invoice")
  status    String    @default("DRAFT")
  issueDate DateTime  @default(now())
  dueDate   DateTime?
  notes     String?
  // Tax on this invoice, your call each time (null = none). Kept as a tax line among the items.
  taxPct    Float?
  taxLabel  String    @default("Sales tax")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  items    InvoiceItem[]
  payments Payment[]
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Float   @default(1)
  unitPrice   Float   @default(0)
  sortOrder   Int     @default(0)
  // The invoice's tax line (its amount follows the other lines).
  isTax       Boolean @default(false)
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Float
  date      DateTime @default(now())
  method    String   @default("CHECK") // CHECK | ACH | CARD | CASH | OTHER
  reference String?
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Daily logs
// ---------------------------------------------------------------------------

model DailyLog {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId      String?
  author        User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  date          DateTime
  weather       String? // Sunny, Rain, ...
  tempHigh      Int?
  tempLow       Int?
  crewCount     Int      @default(0)
  hoursWorked   Float    @default(0)
  workCompleted String?
  issues        String?
  notes         String?
  clientVisible Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  files FileAsset[]
}

// ---------------------------------------------------------------------------
// To-dos
// ---------------------------------------------------------------------------

/// priority: LOW | NORMAL | HIGH ; status: OPEN | DONE
model Todo {
  id          String    @id @default(cuid())
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueDate     DateTime?
  priority    String    @default("NORMAL")
  status      String    @default("OPEN")
  completedAt DateTime?
  assigneeId  String?
  assignee    User?     @relation("TodoAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?     @relation("TodoCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Files & photos
// ---------------------------------------------------------------------------

model FileAsset {
  id                String           @id @default(cuid())
  projectId         String
  project           Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dailyLogId        String?
  dailyLog          DailyLog?        @relation(fields: [dailyLogId], references: [id], onDelete: SetNull)
  uploadedById      String?
  uploadedBy        User?            @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  name              String
  storagePath       String // relative to uploads dir
  mimeType          String
  size              Int
  folder            String           @default("Documents") // Photos | Plans | Documents | Contracts
  clientVisible     Boolean          @default(true)
  createdAt         DateTime         @default(now())
  // A selection's file, or a choice's picture.
  selectionId       String?
  selection         Selection?       @relation(fields: [selectionId], references: [id], onDelete: SetNull)
  selectionOptionId String?
  selectionOption   SelectionOption? @relation(fields: [selectionOptionId], references: [id], onDelete: SetNull)
  changeOrderId     String?
  changeOrder       ChangeOrder?     @relation(fields: [changeOrderId], references: [id], onDelete: SetNull)

  takeoffPlan TakeoffPlan?
  views       FileView[]
  bidsSent    Bid[]        @relation("BidSentFile")
  bidsBack    Bid[]        @relation("BidReturnFile")
}

/// A client opened a file (from its link, not a thumbnail) — proof they saw it before choosing.
model FileView {
  id       String    @id @default(cuid())
  fileId   String
  file     FileAsset @relation(fields: [fileId], references: [id], onDelete: Cascade)
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  viewedAt DateTime  @default(now())

  @@unique([fileId, userId])
}

// ---------------------------------------------------------------------------
// Takeoffs (measure quantities on plan sheets, push them into an estimate)
// ---------------------------------------------------------------------------

/// A plan set (PDF or image) uploaded for takeoff. The file itself lives in Files → Plans.
/// kind: PDF | IMAGE
model TakeoffPlan {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileId    String    @unique
  file      FileAsset @relation(fields: [fileId], references: [id], onDelete: Cascade)
  name      String
  kind      String    @default("PDF")
  pageCount Int? // filled in the first time the plan is opened
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Revisions: the plan set this one replaces (Rev 2 → Rev 1), its number, and when a
  // newer revision took its takeoffs (then it's kept only to compare against).
  revisionOfId String?
  revisionOf   TakeoffPlan?  @relation("PlanRevisions", fields: [revisionOfId], references: [id], onDelete: SetNull)
  revisions    TakeoffPlan[] @relation("PlanRevisions")
  revision     Int           @default(1)
  supersededAt DateTime?

  sheets TakeoffSheet[]
}

/// One page of a plan set. Points are stored in page units (PDF points at 100%,
/// or image pixels); `unitsPerFoot` converts them to real-world feet.
model TakeoffSheet {
  id           String      @id @default(cuid())
  planId       String
  plan         TakeoffPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  pageNumber   Int
  name         String
  unitsPerFoot Float? // null until the scale is set
  scaleLabel   String? // e.g. 1/4" = 1'-0" or "Calibrated"

  // Revisions: the matching sheet in the previous revision, and how it lines up with this
  // one — JSON {a,b,tx,ty}: this = [a −b; b a]·previous + [tx, ty] (page units). Null = as is.
  prevSheetId String?
  prevSheet   TakeoffSheet?  @relation("SheetRevisions", fields: [prevSheetId], references: [id], onDelete: SetNull)
  nextSheets  TakeoffSheet[] @relation("SheetRevisions")
  align       String?

  measurements TakeoffMeasurement[]

  @@unique([planId, pageNumber])
}

/// What gets measured (e.g. "LVP Flooring", "2x10 Floor Joists").
/// type: AREA | LINEAR | COUNT | FRAMING | HIP_VALLEY | WALL | OPENING | DOOR | WINDOW
/// metric: which computed quantity is the condition's quantity (see src/lib/takeoff.ts)
/// pitchMode (LINEAR): COMMON (rakes, rafters) | HIP (hips & valleys)
model TakeoffCondition {
  id            String      @id @default(cuid())
  projectId     String
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name          String
  type          String      @default("AREA")
  metric        String      @default("area")
  color         String      @default("#2563eb")
  group         String      @default("Takeoff") // estimate section heading
  // Reference only: measured for your information (e.g. Heated & cooled, to check the plan) —
  // never on the estimate, the Material list or the unpriced warnings.
  referenceOnly Boolean     @default(false)
  costCodeId    String?
  costCode      CostCode?   @relation(fields: [costCodeId], references: [id], onDelete: SetNull)
  unitCost      Float       @default(0)
  markupPct     Float       @default(20)
  wastePct      Float       @default(0)
  pitch         Float       @default(0) // rise in inches per 12" of run
  pitchMode     String      @default("COMMON")
  pitch2        Float? // hips & valleys: the other side's pitch (null = same as pitch)
  height        Float       @default(0) // feet — linear × height = wall area
  depth         Float       @default(0) // inches — area × depth = volume
  spacing       Float       @default(16) // inches on center — framing
  overhang      Float       @default(0) // inches of horizontal overhang per member — framing
  memberSize    String? // framing: "2x8", "LVL 1-3/4x11-7/8" — nominal size for board feet
  memberSizeId  String?
  memberSizeRef MemberSize? @relation(fields: [memberSizeId], references: [id], onDelete: SetNull)
  options       String? // walls / openings: their settings as JSON (plates, sheathing, headers…)
  stockLengths  String? // framing: lengths you buy, in feet, e.g. "8,10,12,14,16" (blank = even lengths from 8')
  packMode      String      @default("WASTE") // joists/rafters: WASTE (least waste) | CHEAPEST | LENGTH (one board length)
  packLength    Float? // LENGTH: the board length in feet
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  measurements  TakeoffMeasurement[]
  items         TakeoffAssemblyItem[]
  estimateItems EstimateItem[]
}

/// A shape drawn on a sheet. `points` is a JSON array of [x, y] page-unit pairs.
/// `angle` (radians) is the member direction for FRAMING areas.
model TakeoffMeasurement {
  id             String           @id @default(cuid())
  sheetId        String
  sheet          TakeoffSheet     @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  conditionId    String
  condition      TakeoffCondition @relation(fields: [conditionId], references: [id], onDelete: Cascade)
  points         String
  isDeduction    Boolean          @default(false)
  angle          Float            @default(0)
  // Joists/rafters and hips/valleys: this shape's own pitch (null = the condition's).
  pitch          Float?
  pitch2         Float?
  // Linear: this line's own wall height in feet (null = the condition's).
  height         Float?
  // Doors takeoff: which door this marker is (an Item List item with a size).
  materialItemId String?
  materialItem   MaterialItem?    @relation(fields: [materialItemId], references: [id], onDelete: SetNull)
  cased          Boolean? // Windows: trimmed (cased) or not; null = cased
  createdAt      DateTime         @default(now())
}

/// Assembly: an estimate line derived from a condition's quantities,
/// e.g. drywall area → "1 sheet per 32 sf", "0.05 gal mud per 1 sf".
/// quantity = metric value × qty ÷ per × (1 + waste%), optionally rounded up.
model TakeoffAssemblyItem {
  id             String           @id @default(cuid())
  conditionId    String
  condition      TakeoffCondition @relation(fields: [conditionId], references: [id], onDelete: Cascade)
  description    String
  costCodeId     String?
  costCode       CostCode?        @relation(fields: [costCodeId], references: [id], onDelete: SetNull)
  metric         String
  qty            Float            @default(1)
  per            Float            @default(1)
  unit           String           @default("ea")
  roundUp        Boolean          @default(false)
  wastePct       Float            @default(0)
  unitCost       Float            @default(0)
  markupPct      Float            @default(20)
  sortOrder      Int              @default(0)
  // The Item List entry this was picked from. An unlocked job follows its price; a locked
  // job keeps its own until you update it (Price review).
  materialItemId String?
  // "This job only": keeps its own price when the Item List changes.
  pricePinned    Boolean          @default(false)
  materialItem   MaterialItem?    @relation(fields: [materialItemId], references: [id], onDelete: SetNull)

  estimateItems EstimateItem[]
}

/// Company-wide Item List: materials and labor picked into takeoff assemblies.
/// New items typed into an assembly are added here automatically.
model MaterialItem {
  id         String    @id @default(cuid())
  name       String
  nameKey    String    @unique // lower-cased, single-spaced name — keeps "Concrete" and "concrete" one item
  category   String    @default("General")
  unit       String    @default("ea")
  unitCost   Float     @default(0)
  markupPct  Float     @default(20)
  wastePct   Float     @default(0)
  roundUp    Boolean   @default(false)
  costCodeId String?
  costCode   CostCode? @relation(fields: [costCodeId], references: [id], onDelete: SetNull)
  vendor     String?
  sku        String?
  notes      String?
  // Doors (and other sized items): rough size, interior / exterior, and the length one piece comes in (casing sticks).
  widthIn    Float?
  heightIn   Float?
  exterior   Boolean?
  style      String? // windows (and doors): type, e.g. Single hung, Slider
  lengthFt   Float?
  // What the program uses it as, whatever category you file it under:
  // windows | doors | framing lumber | sheathing | drywall | trim (null = your own item).
  kind       String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  assemblyItems TakeoffAssemblyItem[]
  templateItems TakeoffTemplateItem[]
  measurements  TakeoffMeasurement[]
  estimateItems EstimateItem[]
}

/// The cost code for items the program creates by itself (windows, doors, lumber,
/// sheathing, drywall, trim), remembered from "do all windows use the same cost code?".
/// group: "windows", "doors:interior", "doors:exterior", "framing lumber", "sheathing", "drywall", "trim".
/// sameForAll false = ask for a code on each new item.
model ItemCodeRule {
  id         String    @id @default(cuid())
  group      String    @unique
  sameForAll Boolean   @default(true)
  category   String? // the Item List category new items of this kind go in (null = the built-in name)
  costCodeId String?
  costCode   CostCode? @relation(fields: [costCodeId], references: [id], onDelete: SetNull)
  updatedAt  DateTime  @updatedAt
}

/// Framing member library (Settings → Member sizes).
/// kind: DIMENSIONAL | I_JOIST | OPEN_WEB | ENGINEERED | OTHER
/// soldAs: STOCK (pieces rounded up to stock lengths, priced each)
///       | EXACT_LF (made to exact length, listed per length, priced per lf)
///       | LF (one lineal-foot total, priced per lf)
model MemberSize {
  id           String   @id @default(cuid())
  name         String
  nameKey      String   @unique
  kind         String   @default("DIMENSIONAL")
  widthIn      Float    @default(1.5) // actual thickness, inches
  depthIn      Float    @default(5.5) // actual depth, inches
  soldAs       String   @default("STOCK")
  stockLengths String? // default stock lengths in feet, e.g. "8-24"
  boardFeet    Boolean  @default(true) // report board feet (nominal size from the name)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  conditions         TakeoffCondition[]
  templateConditions TakeoffTemplateCondition[]
}

/// Reusable set of takeoff conditions (Settings → Takeoff templates), copied into jobs.
model TakeoffTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  conditions TakeoffTemplateCondition[]
}

model TakeoffTemplateCondition {
  id            String          @id @default(cuid())
  templateId    String
  template      TakeoffTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name          String
  type          String          @default("AREA")
  metric        String          @default("area")
  color         String          @default("#2563eb")
  group         String          @default("Takeoff")
  referenceOnly Boolean         @default(false)
  costCodeId    String?
  costCode      CostCode?       @relation(fields: [costCodeId], references: [id], onDelete: SetNull)
  unitCost      Float           @default(0)
  markupPct     Float           @default(20)
  wastePct      Float           @default(0)
  pitch         Float           @default(0)
  pitchMode     String          @default("COMMON")
  pitch2        Float? // hips & valleys: the other side's pitch (null = same as pitch)
  height        Float           @default(0)
  depth         Float           @default(0)
  spacing       Float           @default(16)
  overhang      Float           @default(0)
  memberSize    String?
  memberSizeId  String?
  memberSizeRef MemberSize?     @relation(fields: [memberSizeId], references: [id], onDelete: SetNull)
  options       String?
  stockLengths  String?
  packMode      String          @default("WASTE")
  packLength    Float?
  sortOrder     Int             @default(0)

  items TakeoffTemplateItem[]
}

/// A template condition's assembly / add-on item. Linked Item List entries take
/// the Item List's current price when the template is applied to a job.
model TakeoffTemplateItem {
  id             String                   @id @default(cuid())
  conditionId    String
  condition      TakeoffTemplateCondition @relation(fields: [conditionId], references: [id], onDelete: Cascade)
  description    String
  costCodeId     String?
  costCode       CostCode?                @relation(fields: [costCodeId], references: [id], onDelete: SetNull)
  materialItemId String?
  materialItem   MaterialItem?            @relation(fields: [materialItemId], references: [id], onDelete: SetNull)
  metric         String
  qty            Float                    @default(1)
  per            Float                    @default(1)
  unit           String                   @default("ea")
  roundUp        Boolean                  @default(false)
  wastePct       Float                    @default(0)
  unitCost       Float                    @default(0)
  markupPct      Float                    @default(20)
  sortOrder      Int                      @default(0)
}

// ---------------------------------------------------------------------------
// Messaging
// ---------------------------------------------------------------------------

model MessageThread {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subject       String
  clientVisible Boolean  @default(true)
  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())

  messages Message[]
}

model Message {
  id        String        @id @default(cuid())
  threadId  String
  thread    MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime      @default(now())
}

// ---------------------------------------------------------------------------
// Activity feed
// ---------------------------------------------------------------------------

model Activity {
  id          String   @id @default(cuid())
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  type        String // e.g. "project.created", "change_order.approved"
  description String
  createdAt   DateTime @default(now())
}

/// A supplier you ask for prices (Settings → Vendors). `costCodeIds`: JSON array of the
/// cost codes they usually bid — picked for them when you request bids.
model Vendor {
  id          String   @id @default(cuid())
  name        String
  contact     String?
  email       String?
  phone       String?
  notes       String?
  costCodeIds String? // JSON ["<costCodeId>", "none", …]
  createdAt   DateTime @default(now())

  bids Bid[]
}

/// A request for prices: one vendor, one job, the Material list items of the cost codes
/// chosen. Sent as an Excel file (saved to the job's Files, folder Bids); the vendor fills
/// in unit prices and the returned file is imported (also saved to Files).
/// status: SENT | RECEIVED. `afterLock`: sent after the job's prices were locked (a re-bid).
model Bid {
  id           String     @id @default(cuid())
  projectId    String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendorId     String?
  vendor       Vendor?    @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  vendorName   String // kept if the vendor is deleted
  number       Int // per job: Bid #1, #2…
  status       String     @default("SENT")
  afterLock    Boolean    @default(false)
  sentAt       DateTime   @default(now())
  receivedAt   DateTime?
  sentFileId   String?
  sentFile     FileAsset? @relation("BidSentFile", fields: [sentFileId], references: [id], onDelete: SetNull)
  returnFileId String?
  returnFile   FileAsset? @relation("BidReturnFile", fields: [returnFileId], references: [id], onDelete: SetNull)
  notes        String?

  lines  BidLine[]
  awards BidAward[]
}

/// One item on a bid, as sent (name, quantity, unit), and the vendor's price once back.
/// `key` is the Material list line key; `codeKey` the cost code id or "none".
model BidLine {
  id             String  @id @default(cuid())
  bidId          String
  bid            Bid     @relation(fields: [bidId], references: [id], onDelete: Cascade)
  key            String
  materialItemId String?
  codeKey        String
  codeLabel      String // "06-100 Framing" as sent
  name           String
  sku            String?
  unit           String
  quantity       Float
  unitPrice      Float? // null = not priced (yet)
  substitute     String?
  note           String?
  sortOrder      Int     @default(0)
}

/// The bid you took for a cost code on a job, and where its prices went:
/// scope JOB (this job only) or COMPANY (the Item List, every job).
model BidAward {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  codeKey   String
  bidId     String
  bid       Bid      @relation(fields: [bidId], references: [id], onDelete: Cascade)
  scope     String   @default("JOB")
  awardedAt DateTime @default(now())

  @@unique([projectId, codeKey])
}
