  // A reminder tied to a schedule task: due `taskOffset` workdays from its start (−3 = 3 before), moving with it.
  taskId      String?
  task        ScheduleTask? @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskOffset  Int?
  // A lead's follow-up (or its meeting).
