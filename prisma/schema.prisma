// ---------------------------------------------------------------------------
// Takeoffs (measure quantities on plan sheets, push them into an estimate)
// ---------------------------------------------------------------------------

/// A plan set (PDF or image) uploaded for takeoff. The file itself lives in Files → Plans.
/// kind: PDF | IMAGE
model TakeoffPlan {
  id        String    @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId String    @default(dbgenerated("current_setting('app.company_id'::text)"))
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileId    String    @unique
  file      FileAsset @relation(fields: [fileId], references: [id], onDelete: Cascade)
  name      String
  kind      String    @default("PDF")
  pageCount Int? // filled in the first time the plan is opened
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Revisions: the plan set this one replaces (Rev 2 → Rev 1), its number, and when a
  // newer revision took its takeoffs (then it's kept only to compare against).
  revisionOfId String?
  revisionOf   TakeoffPlan?  @relation("PlanRevisions", fields: [revisionOfId], references: [id], onDelete: SetNull)
  revisions    TakeoffPlan[] @relation("PlanRevisions")
  revision     Int           @default(1)
  supersededAt DateTime?

  sheets TakeoffSheet[]

  @@index([companyId])
}

/// One page of a plan set. Points are stored in page units (PDF points at 100%,
/// or image pixels); `unitsPerFoot` converts them to real-world feet.
model TakeoffSheet {
  id           String      @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId    String      @default(dbgenerated("current_setting('app.company_id'::text)"))
  planId       String
  plan         TakeoffPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  pageNumber   Int
  name         String
  unitsPerFoot Float? // null until the scale is set
  scaleLabel   String? // e.g. 1/4" = 1'-0" or "Calibrated"

  // Revisions: the matching sheet in the previous revision, and how it lines up with this
  // one — JSON {a,b,tx,ty}: this = [a −b; b a]·previous + [tx, ty] (page units). Null = as is.
  prevSheetId String?
  prevSheet   TakeoffSheet?  @relation("SheetRevisions", fields: [prevSheetId], references: [id], onDelete: SetNull)
  nextSheets  TakeoffSheet[] @relation("SheetRevisions")
  align       String?

  // The floor above, laid over this sheet to draw the floor joists on (src/lib/upper-floor.ts):
  // JSON {sourceSheetId, walls, align}. A picture only — nothing in it is counted. Null = none.
  upperFloor String?

  measurements TakeoffMeasurement[]
  areaFinds    AreaFindLog[]

  @@unique([planId, pageNumber])
  @@index([companyId])
}

/// What gets measured (e.g. "LVP Flooring", "2x10 Floor Joists").
/// type: AREA | LINEAR | COUNT | FRAMING | HIP_VALLEY | WALL | OPENING | DOOR | WINDOW
/// metric: which computed quantity is the condition's quantity (see src/lib/takeoff.ts)
/// pitchMode (LINEAR): COMMON (rakes, rafters) | HIP (hips & valleys)
model TakeoffCondition {
  id            String      @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId     String      @default(dbgenerated("current_setting('app.company_id'::text)"))
  projectId     String
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name          String
  type          String      @default("AREA")
  metric        String      @default("area")
  color         String      @default("#2563eb")
  group         String      @default("Takeoff") // estimate section heading
  // Reference only: measured for your information (e.g. Heated & cooled, to check the plan) —
  // never on the estimate, the Material list or the unpriced warnings.
  referenceOnly Boolean     @default(false)
  costCodeId    String?
  costCode      CostCode?   @relation(fields: [costCodeId], references: [id], onDelete: SetNull)
  unitCost      Float       @default(0)
  wastePct      Float       @default(0)
  pitch         Float       @default(0) // rise in inches per 12" of run
  pitchMode     String      @default("COMMON")
  pitch2        Float? // hips & valleys: the other side's pitch (null = same as pitch)
  height        Float       @default(0) // feet — linear × height = wall area
  depth         Float       @default(0) // inches — area × depth = volume
  spacing       Float       @default(16) // inches on center — framing
  overhang      Float       @default(0) // inches of horizontal overhang per member — framing
  memberSize    String? // framing: "2x8", "LVL 1-3/4x11-7/8" — nominal size for board feet
  memberSizeId  String?
  memberSizeRef MemberSize? @relation(fields: [memberSizeId], references: [id], onDelete: SetNull)
  options       String? // walls / openings: their settings as JSON (plates, sheathing, headers…)
  stockLengths  String? // framing: lengths you buy, in feet, e.g. "8,10,12,14,16" (blank = even lengths from 8')
  packMode      String      @default("WASTE") // joists/rafters: WASTE (least waste) | CHEAPEST | LENGTH (one board length)
  packLength    Float? // LENGTH: the board length in feet
  // Joists/rafters sized by a span table: each shape goes to the takeoff of the size its span
  // calls for. The takeoffs of one family (one per size) share `sizeGroup`.
  spanTableId   String?
  spanTable     SpanTable?  @relation(fields: [spanTableId], references: [id], onDelete: SetNull)
  sizeGroup     String?
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  measurements  TakeoffMeasurement[]
  items         TakeoffAssemblyItem[]
  estimateItems EstimateItem[]

  @@index([companyId])
}

/// A shape drawn on a sheet. `points` is a JSON array of [x, y] page-unit pairs.
/// `angle` (radians) is the member direction for FRAMING areas.
// Every Find area click and what it gave — kept quietly, to learn where the room finder goes wrong
// (src/lib/room-detect). What the user did with the area isn't stored: it's read later from the
// measurement itself — still there as found (kept), changed (split, or corners moved) or gone (undone
// or deleted). Nothing here is shown in the app.
model AreaFindLog {
  id            String       @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId     String       @default(dbgenerated("current_setting('app.company_id'::text)"))
  projectId     String
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sheetId       String
  sheet         TakeoffSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  conditionId   String? // the takeoff it was added to
  // Where the click was (page units) and the sheet's scale then.
  clickX        Float
  clickY        Float
  unitsPerFoot  Float
  // The room finder's version (ROOM_DETECT_VERSION) — results are compared within a version.
  version       String
  // What it gave: a room (area, outline JSON [[x,y],…]) or why not ("open", "in-wall", …).
  ok            Boolean
  reason        String?
  areaSf        Float?
  outline       String?
  isDeduction   Boolean      @default(false)
  // The area it added (a plain id, not a link: the area being undone or deleted is the point).
  measurementId String?
  ms            Int? // how long the click took to work out
  createdAt     DateTime     @default(now())

  @@index([companyId])
  @@index([measurementId])
}

model TakeoffMeasurement {
  id             String           @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId      String           @default(dbgenerated("current_setting('app.company_id'::text)"))
  sheetId        String
  sheet          TakeoffSheet     @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  conditionId    String
  condition      TakeoffCondition @relation(fields: [conditionId], references: [id], onDelete: Cascade)
  points         String
  isDeduction    Boolean          @default(false)
  angle          Float            @default(0)
  // Joists/rafters and hips/valleys: this shape's own pitch (null = the condition's).
  pitch          Float?
  pitch2         Float?
  // Linear: this line's own wall height in feet (null = the condition's).
  height         Float?
  // Doors takeoff: which door this marker is (an Item List item with a size).
  materialItemId String?
  materialItem   MaterialItem?    @relation(fields: [materialItemId], references: [id], onDelete: SetNull)
  cased          Boolean? // Windows: trimmed (cased) or not; null = cased
  // Joists/rafters on a span table: you picked this shape's size yourself — the table leaves it be.
  sizeLocked     Boolean          @default(false)
  // Joists/rafters broken at walls: your calls on single bays (src/lib/joist-sections.ts) — JSON
  // { sizes: { "<wall>|<wall>": "2x8" }, through: ["<wall id>"] }. Null = the table's / the takeoff's.
  sections       String?
  createdAt      DateTime         @default(now())

  @@index([companyId])
}

/// Assembly: an estimate line derived from a condition's quantities,
/// e.g. drywall area → "1 sheet per 32 sf", "0.05 gal mud per 1 sf".
/// quantity = metric value × qty ÷ per × (1 + waste%), optionally rounded up.
model TakeoffAssemblyItem {
  id             String           @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId      String           @default(dbgenerated("current_setting('app.company_id'::text)"))
  conditionId    String
  condition      TakeoffCondition @relation(fields: [conditionId], references: [id], onDelete: Cascade)
  description    String
  costCodeId     String?
  costCode       CostCode?        @relation(fields: [costCodeId], references: [id], onDelete: SetNull)
  metric         String
  qty            Float            @default(1)
  per            Float            @default(1)
  unit           String           @default("ea")
  roundUp        Boolean          @default(false)
  wastePct       Float            @default(0)
  unitCost       Float            @default(0)
  sortOrder      Int              @default(0)
  // The Item List entry this was picked from. An unlocked job follows its price; a locked
  // job keeps its own until you update it (Price review).
  materialItemId String?
  // "This job only": keeps its own price when the Item List changes.
  pricePinned    Boolean          @default(false)
  materialItem   MaterialItem?    @relation(fields: [materialItemId], references: [id], onDelete: SetNull)

  estimateItems EstimateItem[]

  @@index([companyId])
}

/// Company-wide Item List: materials and labor picked into takeoff assemblies.
/// New items typed into an assembly are added here automatically.
model MaterialItem {
  id             String    @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId      String    @default(dbgenerated("current_setting('app.company_id'::text)"))
  name           String
  nameKey        String // lower-cased, single-spaced name — keeps "Concrete" and "concrete" one item
  category       String    @default("General")
  unit           String    @default("ea")
  unitCost       Float     @default(0)
  wastePct       Float     @default(0)
  roundUp        Boolean   @default(false)
  costCodeId     String?
  costCode       CostCode? @relation(fields: [costCodeId], references: [id], onDelete: SetNull)
  vendor         String?
  sku            String?
  notes          String?
  // Doors (and other sized items): rough size, interior / exterior, and the length one piece comes in (casing sticks).
  widthIn        Float?
  heightIn       Float?
  exterior       Boolean?
  style          String? // windows (and doors): type, e.g. Single hung, Slider
  // Windows: the color — Standard (white), White/Black (white inside, black outside) or Black/Black; null = not a window.
  color          String?
  // Windows: the company's own details (Settings → Windows), JSON { "Grids": "Yes", "Glass": "Low-E" }.
  details        String?
  lengthFt       Float?
  // What the program uses it as, whatever category you file it under:
  // windows | doors | framing lumber | sheathing | drywall | trim (null = your own item).
  kind           String?
  // When its price was last set or confirmed ("Price still good") — stale once past its cost code's recheck time.
  priceCheckedAt DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  assemblyItems TakeoffAssemblyItem[]
  templateItems TakeoffTemplateItem[]
  measurements  TakeoffMeasurement[]
  estimateItems EstimateItem[]
  inventory     InventoryItem?

  @@unique([companyId, nameKey])
  @@index([companyId])
}

/// The cost code for items the program creates by itself (windows, doors, lumber,
/// sheathing, drywall, trim), remembered from "do all windows use the same cost code?".
/// group: "windows", "doors:interior", "doors:exterior", "framing lumber", "sheathing", "drywall", "trim".
/// sameForAll false = ask for a code on each new item.
model ItemCodeRule {
  id         String    @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId  String    @default(dbgenerated("current_setting('app.company_id'::text)"))
  group      String
  sameForAll Boolean   @default(true)
  category   String? // the Item List category new items of this kind go in (null = the built-in name)
  costCodeId String?
  costCode   CostCode? @relation(fields: [costCodeId], references: [id], onDelete: SetNull)
  updatedAt  DateTime  @updatedAt

  @@unique([companyId, group])
  @@index([companyId])
}

/// Framing member library (Settings → Member sizes).
/// kind: DIMENSIONAL | I_JOIST | OPEN_WEB | ENGINEERED | OTHER
/// soldAs: STOCK (pieces rounded up to stock lengths, priced each)
///       | EXACT_LF (made to exact length, listed per length, priced per lf)
///       | LF (one lineal-foot total, priced per lf)
/// Settings → Span tables: which joist / rafter size a span calls for — your own rows
/// ("up to 12' → 2x6"), or the code's (figured from species, grade and loads).
model SpanTable {
  id        String   @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId String   @default(dbgenerated("current_setting('app.company_id'::text)"))
  name      String
  use       String   @default("FLOOR") // FLOOR | CEILING | RAFTER
  source    String   @default("CUSTOM") // CUSTOM (your rows) | CODE
  species   String   @default("SPF2") // CODE: species & grade (span-tables.ts SPECIES)
  load      String   @default("") // CODE: design loads (span-tables.ts SPAN_LOADS)
  rows      String   @default("[]") // CUSTOM: JSON [{ upToFt, size }] — size is a member size name
  overSize  String? // past the table: this member (a member size name, e.g. "TJI 210")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conditions TakeoffCondition[]

  @@index([companyId])
}

model MemberSize {
  id           String   @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId    String   @default(dbgenerated("current_setting('app.company_id'::text)"))
  name         String
  nameKey      String
  kind         String   @default("DIMENSIONAL")
  widthIn      Float    @default(1.5) // actual thickness, inches
  depthIn      Float    @default(5.5) // actual depth, inches
  soldAs       String   @default("STOCK")
  stockLengths String? // default stock lengths in feet, e.g. "8-24"
  boardFeet    Boolean  @default(true) // report board feet (nominal size from the name)
  // Its color on the plan: joist / rafter takeoffs of this size use it, on every job.
  color        String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  conditions         TakeoffCondition[]
  templateConditions TakeoffTemplateCondition[]

  @@unique([companyId, nameKey])
  @@index([companyId])
}

/// Reusable set of takeoff conditions (Settings → Takeoff templates), copied into jobs.
model TakeoffTemplate {
  id          String   @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId   String   @default(dbgenerated("current_setting('app.company_id'::text)"))
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  conditions TakeoffTemplateCondition[]

  @@index([companyId])
}

model TakeoffTemplateCondition {
  id            String          @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId     String          @default(dbgenerated("current_setting('app.company_id'::text)"))
  templateId    String
  template      TakeoffTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name          String
  type          String          @default("AREA")
  metric        String          @default("area")
  color         String          @default("#2563eb")
  group         String          @default("Takeoff")
  referenceOnly Boolean         @default(false)
  costCodeId    String?
  costCode      CostCode?       @relation(fields: [costCodeId], references: [id], onDelete: SetNull)
  unitCost      Float           @default(0)
  wastePct      Float           @default(0)
  pitch         Float           @default(0)
  pitchMode     String          @default("COMMON")
  pitch2        Float? // hips & valleys: the other side's pitch (null = same as pitch)
  height        Float           @default(0)
  depth         Float           @default(0)
  spacing       Float           @default(16)
  overhang      Float           @default(0)
  memberSize    String?
  memberSizeId  String?
  memberSizeRef MemberSize?     @relation(fields: [memberSizeId], references: [id], onDelete: SetNull)
  options       String?
  stockLengths  String?
  packMode      String          @default("WASTE")
  packLength    Float?
  spanTableId   String? // the span table it sizes by (kept as is; checked when the template is used)
  sortOrder     Int             @default(0)

  items TakeoffTemplateItem[]

  @@index([companyId])
}

/// A template condition's assembly / add-on item. Linked Item List entries take
/// the Item List's current price when the template is applied to a job.
model TakeoffTemplateItem {
  id             String                   @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId      String                   @default(dbgenerated("current_setting('app.company_id'::text)"))
  conditionId    String
  condition      TakeoffTemplateCondition @relation(fields: [conditionId], references: [id], onDelete: Cascade)
  description    String
  costCodeId     String?
  costCode       CostCode?                @relation(fields: [costCodeId], references: [id], onDelete: SetNull)
  materialItemId String?
  materialItem   MaterialItem?            @relation(fields: [materialItemId], references: [id], onDelete: SetNull)
  metric         String
  qty            Float                    @default(1)
  per            Float                    @default(1)
  unit           String                   @default("ea")
  roundUp        Boolean                  @default(false)
  wastePct       Float                    @default(0)
  unitCost       Float                    @default(0)
  sortOrder      Int                      @default(0)

  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Messaging
// ---------------------------------------------------------------------------

model MessageThread {
  id            String   @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId     String   @default(dbgenerated("current_setting('app.company_id'::text)"))
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subject       String
  clientVisible Boolean  @default(true)
  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())

  messages Message[]

  @@index([companyId])
}

model Message {
  id        String        @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId String        @default(dbgenerated("current_setting('app.company_id'::text)"))
  threadId  String
  thread    MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime      @default(now())

  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Activity feed
// ---------------------------------------------------------------------------

model Activity {
  id          String   @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId   String   @default(dbgenerated("current_setting('app.company_id'::text)"))
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  type        String // e.g. "project.created", "change_order.approved"
  description String
  createdAt   DateTime @default(now())

  @@index([companyId])
}

/// A supplier you ask for prices (Settings → Vendors). `costCodeIds`: JSON array of the
/// cost codes they usually bid — picked for them when you request bids.
model Vendor {
  id                String   @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId         String   @default(dbgenerated("current_setting('app.company_id'::text)"))
  name              String
  contact           String?
  email             String?
  phone             String?
  notes             String?
  costCodeIds       String? // JSON ["<costCodeId>", "none", …]
  // Insurance needed? null = automatic: yes once they're on a PO for work (not a supplier's bid) or have a certificate on file.
  insuranceRequired Boolean?
  // Paperwork this vendor needs (JSON { "<PaperworkType id>": "YYYY-MM-DD" needed since }); null = not set up yet.
  paperwork         String?
  // QuickBooks Desktop: the vendor it is there (its ListID) — see src/lib/qb.
  qbListId          String?
  createdAt         DateTime @default(now())

  bids           Bid[]
  purchaseOrders PurchaseOrder[]
  bills          VendorBill[]
  insurance      VendorInsurance[]
  docs           VendorDoc[]
  logins         User[]
  tasks          ScheduleTask[]
  siteJobs       ProjectVendor[]
  warranty       WarrantyRequest[]

  @@unique([companyId, qbListId])
  @@index([companyId])
}

/// A request for prices: one vendor, one job, the Material list items of the cost codes
/// chosen. Sent as an Excel file (saved to the job's Files, folder Bids); the vendor fills
/// in unit prices and the returned file is imported (also saved to Files).
/// status: SENT | RECEIVED. `afterLock`: sent after the job's prices were locked (a re-bid).
model Bid {
  id           String     @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId    String     @default(dbgenerated("current_setting('app.company_id'::text)"))
  projectId    String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendorId     String?
  vendor       Vendor?    @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  vendorName   String // kept if the vendor is deleted
  number       Int // per job: Bid #1, #2…
  status       String     @default("SENT")
  afterLock    Boolean    @default(false)
  sentAt       DateTime   @default(now())
  receivedAt   DateTime?
  sentFileId   String?
  sentFile     FileAsset? @relation("BidSentFile", fields: [sentFileId], references: [id], onDelete: SetNull)
  returnFileId String?
  returnFile   FileAsset? @relation("BidReturnFile", fields: [returnFileId], references: [id], onDelete: SetNull)
  notes        String?
  // MATERIAL: Material list items, a price each. SUB: a sub bids whole trades (cost codes) from the plans —
  // one line per trade (1 ls), their price for it; `planFileIds` the job's files they can see (JSON ids).
  kind         String     @default("MATERIAL")
  dueAt        DateTime?
  planFileIds  String?

  lines  BidLine[]
  awards BidAward[]

  @@index([companyId])
}

/// One item on a bid, as sent (name, quantity, unit), and the vendor's price once back.
/// `key` is the Material list line key; `codeKey` the cost code id or "none".
model BidLine {
  id             String  @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId      String  @default(dbgenerated("current_setting('app.company_id'::text)"))
  bidId          String
  bid            Bid     @relation(fields: [bidId], references: [id], onDelete: Cascade)
  key            String
  materialItemId String?
  codeKey        String
  codeLabel      String // "06-100 Framing" as sent
  name           String
  sku            String?
  unit           String
  quantity       Float
  unitPrice      Float? // null = not priced (yet)
  substitute     String?
  note           String?
  sortOrder      Int     @default(0)

  @@index([companyId])
}

/// The bid you took for a cost code on a job, and where its prices went:
/// scope JOB (this job only) or COMPANY (the Item List, every job). A sub's bid is filed under
/// "sub:<cost code id>" (apart from the material bid for the same code), scope BUDGET (its price put on
/// the estimate) or AWARD (just the one you picked).
model BidAward {
  id        String   @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId String   @default(dbgenerated("current_setting('app.company_id'::text)"))
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  codeKey   String
  bidId     String
  bid       Bid      @relation(fields: [bidId], references: [id], onDelete: Cascade)
  scope     String   @default("JOB")
  awardedAt DateTime @default(now())

  @@unique([projectId, codeKey])
  @@index([companyId])
}

/// A job's substitution: wherever the job orders `from`, it orders `to` instead (a hanger the vendor
/// quoted another brand of, OSB for plywood). Lumber of the same size at another length ("2x6 × 26'"
/// → "2x6 × 28'") is a length substitution (`size`, `fromLen`, `toLen`): that length isn't used on the
/// job, so its cuts come from the other everywhere — the takeoff, labels, cut sheet and order.
model JobSubstitution {
  id         String   @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId  String   @default(dbgenerated("current_setting('app.company_id'::text)"))
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromItemId String
  fromName   String
  toItemId   String?
  toName     String
  size       String?
  fromLen    Float?
  toLen      Float?
  // What it's bought at on this job (a bid's price, or one you typed); null = the Item List's.
  unitCost   Float?
  // "Bid #3, ABC Lumber"; null = you.
  source     String?
  // The takeoff lines it changed and what they were (JSON) — "Swap back" puts them back.
  restore    String?
  createdAt  DateTime @default(now())

  @@unique([projectId, fromItemId])
  @@index([companyId])
}

/// One task waits on another: it starts after `predecessor` finishes, plus `lagDays` workdays.
model TaskLink {
  id            String       @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId     String       @default(dbgenerated("current_setting('app.company_id'::text)"))
  taskId        String
  task          ScheduleTask @relation("LinkTask", fields: [taskId], references: [id], onDelete: Cascade)
  predecessorId String
  predecessor   ScheduleTask @relation("LinkPredecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  lagDays       Int          @default(0)

  @@unique([taskId, predecessorId])
  @@index([companyId])
}

/// Your list of reasons a job is delayed (Rain, Inspection, Material late…).
model DelayReason {
  id        String   @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId String   @default(dbgenerated("current_setting('app.company_id'::text)"))
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([companyId])
}

/// A day a job was delayed: everything not finished moved out `days` workdays from `date`.
model JobDelay {
  id              String   @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId       String   @default(dbgenerated("current_setting('app.company_id'::text)"))
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date            DateTime
  days            Int      @default(1)
  reason          String
  notes           String?
  // The client sees the reason (they always see the new dates).
  shareWithClient Boolean  @default(false)
  // How many tasks it moved.
  moved           Int      @default(0)
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())

  @@index([companyId])
}

/// The company calendar: HOLIDAY (nobody works — schedules skip it) or TIME_OFF (one person:
/// VACATION | SICK | PERSONAL). Reminders are To-Dos with a due date.
model CalendarEvent {
  id          String   @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId   String   @default(dbgenerated("current_setting('app.company_id'::text)"))
  kind        String
  title       String
  startDate   DateTime
  endDate     DateTime
  userId      String?
  user        User?    @relation("TimeOffFor", fields: [userId], references: [id], onDelete: Cascade)
  timeOffType String?
  notes       String?
  createdAt   DateTime @default(now())

  @@index([companyId])
}

/// A schedule you start jobs from: tasks with lengths in workdays and what each waits on.
model ScheduleTemplate {
  id          String                 @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId   String                 @default(dbgenerated("current_setting('app.company_id'::text)"))
  name        String
  description String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  tasks       ScheduleTemplateTask[]

  @@index([companyId])
}

model ScheduleTemplateTask {
  id          String           @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId   String           @default(dbgenerated("current_setting('app.company_id'::text)"))
  templateId  String
  template    ScheduleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name        String
  phase       String           @default("General")
  // Workdays (a milestone is 1).
  duration    Int              @default(1)
  isMilestone Boolean          @default(false)
  color       String           @default("#2563eb")
  notes       String?
  assigneeId  String?
  // What it waits on: JSON [{ "id": <template task id>, "lag": <workdays> }].
  links       String?
  sortOrder   Int              @default(0)

  @@index([companyId])
}

/// A purchase order to a sub or vendor for a job: what they'll do or supply, at what price.
/// status: DRAFT | SENT | ACCEPTED | DECLINED | CLOSED | VOID. Numbered across all jobs (PO-1001).
model PurchaseOrder {
  id           String              @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId    String              @default(dbgenerated("current_setting('app.company_id'::text)"))
  projectId    String
  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendorId     String?
  vendor       Vendor?             @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  vendorName   String
  number       Int
  title        String
  scope        String?
  status       String              @default("DRAFT")
  deliveryDate DateTime?
  // Where it came from: a bid you took (its id), else the budget or blank.
  bidId        String?
  sentAt       DateTime?
  sentById     String? // who marked it sent — they hear back when the vendor answers
  respondedAt  DateTime?
  responseNote String?
  createdById  String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  lines        PurchaseOrderLine[]
  bills        VendorBill[]

  @@unique([companyId, number])
  @@index([companyId])
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId       String        @default(dbgenerated("current_setting('app.company_id'::text)"))
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  description     String
  costCodeId      String?
  costCode        CostCode?     @relation(fields: [costCodeId], references: [id], onDelete: SetNull)
  quantity        Float         @default(1)
  unit            String        @default("ls")
  unitCost        Float         @default(0)
  sortOrder       Int           @default(0)

  @@index([companyId])
}

/// A sub's or vendor's bill for a job, matched to a PO when there is one.
/// status: PENDING | APPROVED | PAID | REJECTED. Approved: its lines are the job's actual cost.
model VendorBill {
  id              String           @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId       String           @default(dbgenerated("current_setting('app.company_id'::text)"))
  projectId       String
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendorId        String?
  vendor          Vendor?          @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  vendorName      String
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  billNumber      String?
  billDate        DateTime
  dueDate         DateTime?
  status          String           @default("PENDING")
  notes           String?
  // The vendor's bill (a FileAsset in the job's Files, folder Bills).
  fileId          String?
  // Sent in by the vendor from their portal.
  fromPortal      Boolean          @default(false)
  // QuickBooks Online: the bill it came from (its Id). A bill there with lines on several jobs is one
  // bill here per job. Kept in step with QuickBooks — changed there, not here.
  qbTxnId         String?
  approvedAt      DateTime?
  approvedById    String?
  approvedBy      User?            @relation("BillApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectedNote    String?
  paidAt          DateTime?
  paidMethod      String?
  paidReference   String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  lines           VendorBillLine[]
  expenses        Expense[]

  @@index([companyId])
  @@index([companyId, qbTxnId])
}

model VendorBillLine {
  id          String     @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId   String     @default(dbgenerated("current_setting('app.company_id'::text)"))
  billId      String
  bill        VendorBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  description String
  costCodeId  String?
  costCode    CostCode?  @relation(fields: [costCodeId], references: [id], onDelete: SetNull)
  amount      Float
  sortOrder   Int        @default(0)

  @@index([companyId])
}

/// A sub's or vendor's insurance certificate (COI). type: GL | WC | AUTO | UMBRELLA | OTHER.
/// One the vendor uploads waits for you to confirm its dates (`confirmed`).
model VendorInsurance {
  id           String   @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId    String   @default(dbgenerated("current_setting('app.company_id'::text)"))
  vendorId     String
  vendor       Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  type         String
  carrier      String?
  policyNumber String?
  expiresAt    DateTime
  confirmed    Boolean  @default(true)
  // The last "about to expire" email sent to the vendor for this certificate: 30, 7 or 0 (days left).
  reminded     Int?
  // The certificate file (stored under uploads/vendors/<vendor>).
  fileName     String?
  storagePath  String?
  mimeType     String?
  createdAt    DateTime @default(now())

  @@index([companyId])
}

/// Kinds of vendor paperwork a company tracks: W-9 and Insurance built in (`kind`), plus its own
/// (Contractor agreement…). `expires`: it has an expiry date. `usual`: ticked for a new vendor.
model PaperworkType {
  id        String      @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId String      @default(dbgenerated("current_setting('app.company_id'::text)"))
  name      String
  kind      String? // W9 | INSURANCE (built in); null = the company's own
  expires   Boolean     @default(false)
  usual     Boolean     @default(true)
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  docs      VendorDoc[]

  @@index([companyId])
}

/// One paper on file for a vendor: its file, and its expiry when the kind expires. `confirmed`: false
/// when the vendor uploaded it from their portal and nobody has looked yet.
model VendorDoc {
  id          String        @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId   String        @default(dbgenerated("current_setting('app.company_id'::text)"))
  vendorId    String
  vendor      Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  typeId      String
  type        PaperworkType @relation(fields: [typeId], references: [id], onDelete: Cascade)
  expiresAt   DateTime?
  confirmed   Boolean       @default(true)
  fileName    String?
  storagePath String?
  mimeType    String?
  createdAt   DateTime      @default(now())

  @@index([companyId])
  @@index([vendorId])
}

// ---------------------------------------------------------------------------
// Inventory: JT&I's stored materials
// ---------------------------------------------------------------------------

/// Something JT&I has in storage: an Item List item (or a name of its own), how many are
/// on hand, and what they're worth each (the average of what was paid).
model InventoryItem {
  id             String          @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId      String          @default(dbgenerated("current_setting('app.company_id'::text)"))
  materialItemId String?         @unique
  materialItem   MaterialItem?   @relation(fields: [materialItemId], references: [id], onDelete: SetNull)
  name           String
  nameKey        String
  unit           String          @default("ea")
  onHand         Float           @default(0)
  avgCost        Float           @default(0)
  notes          String?
  // Taken off the Inventory list (kept only because jobs it was pulled to still point at it).
  removedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  moves          InventoryMove[]

  @@unique([companyId, nameKey])
  @@index([companyId])
}

/// Every change to an inventory count. type: ADD (bought for stock) | PULL (to a job) |
/// RETURN (left over from a job) | COUNT (a recount). `quantity` is the change (+ in, − out).
/// A pull or return charges / credits the job with its own expense (`expenseId`).
/// `lineKey`: the job's Material list line a pull covers (so it orders that much less).
model InventoryMove {
  id        String        @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId String        @default(dbgenerated("current_setting('app.company_id'::text)"))
  itemId    String
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type      String
  quantity  Float
  unitCost  Float         @default(0)
  projectId String?
  project   Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  lineKey   String?
  expenseId String?
  note      String?
  userId    String?
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  undone    Boolean       @default(false)
  createdAt DateTime      @default(now())

  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Leads & sales
// ---------------------------------------------------------------------------

/// Someone who might hire you, from first call to won or lost.
/// stage: INQUIRY | MEETING | ESTIMATE | PROPOSAL | WON | LOST. At ESTIMATE it becomes a
/// job (client + project, `projectId`); from then on the job moves it (estimate sent →
/// PROPOSAL, approved / contracted → WON). LOST is set by you, with a reason.
model Lead {
  id         String      @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId  String      @default(dbgenerated("current_setting('app.company_id'::text)"))
  firstName  String
  lastName   String      @default("")
  company    String?
  email      String?
  phone      String?
  address    String?
  city       String?
  state      String?
  zip        String?
  title      String? // "Kitchen remodel"
  jobType    String      @default("REMODEL")
  value      Float? // rough budget / what it might be worth
  source     String?
  stage      String      @default("INQUIRY")
  stageAt    DateTime    @default(now())
  meetingAt  DateTime?
  wonAt      DateTime?
  lostAt     DateTime?
  lostReason String?
  notes      String?
  sortOrder  Int         @default(0)
  ownerId    String?
  owner      User?       @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  clientId   String?
  client     Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectId  String?     @unique
  project    Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  entries    LeadEntry[]
  todos      Todo[]

  @@index([companyId])
}

/// A lead's log: kind CALL | EMAIL | MEETING | NOTE | STAGE (moved along — written by the program).
model LeadEntry {
  id        String   @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId String   @default(dbgenerated("current_setting('app.company_id'::text)"))
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  kind      String   @default("NOTE")
  text      String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([companyId])
}

/// Your own lead sources (the common ones are always offered too).
model LeadSource {
  id        String   @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId String   @default(dbgenerated("current_setting('app.company_id'::text)"))
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Spec houses
// ---------------------------------------------------------------------------

/// A spec house's listing and what it costs to sell (percent of the price, plus flat amounts).
model SpecSale {
  id             String    @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId      String    @default(dbgenerated("current_setting('app.company_id'::text)"))
  projectId      String    @unique
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  listPrice      Float?
  listedAt       DateTime?
  listPct        Float     @default(3) // listing agent commission %
  buyerPct       Float     @default(2.5) // buyer's agent commission %
  closingPct     Float     @default(1) // seller closing costs, % of price
  closingFlat    Float     @default(0) // seller closing costs, flat (title, warranty…)
  concessions    Float     @default(0) // usual concessions / closing-cost help
  // The seller's closing costs, line by line (JSON [{ name, kind: "PCT" | "FLAT", value, title? }]); null = your defaults.
  closingLines   String?
  // Property taxes for the year (Texas: paid in arrears — at closing you credit the buyer Jan 1 → closing).
  annualTax      Float?
  // HOA dues paid ahead: the buyer pays back the days after closing.
  hoaAnnual      Float?
  hoaPaidThrough DateTime?
  soldAt         DateTime?
  soldPrice      Float?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([companyId])
}

/// What a spec house costs to hold: kind INTEREST (loanBalance × ratePct a year) or AMOUNT
/// (`amount` per `frequency`: MONTHLY | YEARLY | ONCE), from startDate to endDate (or sold).
/// Charged to the job's Budget a month at a time, under its cost code.
model CarryingCost {
  id          String      @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId   String      @default(dbgenerated("current_setting('app.company_id'::text)"))
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  kind        String      @default("AMOUNT")
  amount      Float       @default(0)
  frequency   String      @default("MONTHLY")
  loanBalance Float?
  ratePct     Float?
  startDate   DateTime
  endDate     DateTime?
  costCodeId  String?
  costCode    CostCode?   @relation(fields: [costCodeId], references: [id], onDelete: SetNull)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  expenses    Expense[]
  loanEntries LoanEntry[]

  @@index([companyId])
}

/// A construction loan's history, for its interest line: DRAW (+amount), PAYDOWN (−amount),
/// RATE (new ratePct from this date), ACTUAL (the bank's interest for `month`, "2026-10").
model LoanEntry {
  id             String       @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId      String       @default(dbgenerated("current_setting('app.company_id'::text)"))
  carryingCostId String
  carryingCost   CarryingCost @relation(fields: [carryingCostId], references: [id], onDelete: Cascade)
  kind           String
  date           DateTime
  amount         Float        @default(0)
  ratePct        Float?
  month          String?
  note           String?
  createdAt      DateTime     @default(now())

  @@index([companyId])
}

/// An offer on a spec house, as worked out when it came in.
model SpecOffer {
  id           String   @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId    String   @default(dbgenerated("current_setting('app.company_id'::text)"))
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  buyer        String?
  price        Float
  closingDate  DateTime
  concessions  Float    @default(0)
  buyerPct     Float    @default(0)
  repairs      Float    @default(0)
  profit       Float    @default(0)
  status       String   @default("OPEN") // OPEN | COUNTERED | ACCEPTED | REJECTED
  counterPrice Float?
  note         String?
  userId       String?
  createdAt    DateTime @default(now())

  @@index([companyId])
}

/// One stretch on the clock: someone working on a job (and a cost code) from clockIn to clockOut.
model TimeEntry {
  id              String    @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId       String    @default(dbgenerated("current_setting('app.company_id'::text)"))
  userId          String
  user            User      @relation("TimeEntryUser", fields: [userId], references: [id], onDelete: Cascade)
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  costCodeId      String?
  costCode        CostCode? @relation(fields: [costCodeId], references: [id], onDelete: SetNull)
  clockIn         DateTime
  clockOut        DateTime? // null = still on the clock
  breakMinutes    Int       @default(0)
  // Where the phone was at each punch (GPS, read once at that moment; accuracy in meters). Null: not shared or no signal.
  inLat           Float?
  inLng           Float?
  inAccuracy      Float?
  outLat          Float?
  outLng          Float?
  outAccuracy     Float?
  notes           String?
  // Cost per hour when it was worked (pay + burden), so a raise later doesn't rewrite old jobs.
  // null = no pay rate was set then; the person's current rate is used.
  rate            Float?
  // On the clock a long time: when the "still on the clock?" email went out (once per stretch).
  longShiftSentAt DateTime?
  // Changed by hand (Timesheets) — by whom.
  editedById      String?
  editedBy        User?     @relation("TimeEntryEditor", fields: [editedById], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId, clockIn])
  @@index([projectId, clockIn])
  @@index([companyId])
}

/// A one-time link emailed to someone: confirm their email, or reset their password.
model AuthToken {
  id        String    @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId String    @default(dbgenerated("current_setting('app.company_id'::text)"))
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   String // VERIFY_EMAIL | RESET_PASSWORD
  tokenHash String    @unique // only a hash is kept; the link holds the token itself
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([companyId])
  @@index([userId])
}

/// An invitation to join a company: a team member, a client's portal login, or a vendor's.
model Invite {
  id          String    @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId   String    @default(dbgenerated("current_setting('app.company_id'::text)"))
  kind        String // TEAM | CLIENT | VENDOR
  email       String
  name        String?
  role        String    @default("STAFF") // the role they'll have (TEAM: ADMIN | STAFF)
  permissions String? // TEAM: JSON { positionId, access } — their position and their own changes
  clientId    String? // CLIENT: the client the portal login is for
  vendorId    String? // VENDOR: the vendor
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String?
  invitedBy   User?     @relation("InviteSender", fields: [invitedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([companyId])
  @@index([email])
}

/// QuickBooks Desktop through Intuit's Web Connector (src/lib/qb): one per company. The Web
/// Connector signs in with username + password (only its hash is kept) and is tied to the
/// QuickBooks company file it first synced with.
model QbConnection {
  id           String    @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId    String    @unique @default(dbgenerated("current_setting('app.company_id'::text)"))
  username     String    @unique
  passwordHash String
  fileId       String // the .qwc file's FileID
  companyFile  String? // the QuickBooks company file (path), from the first sync
  qbCompany    String? // its company name, as QuickBooks has it
  lastSyncAt   DateTime?
  lastError    String?
  // The Web Connector session in progress: its ticket and what's left to ask for (JSON).
  ticket       String?   @unique
  ticketState  String?
  ticketAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// A QuickBooks list entry as last read: kind VENDOR | CUSTOMER (customers and their jobs) |
/// ITEM | CLASS. listId is QuickBooks' own id; detail is JSON (item type, description…).
model QbListItem {
  id           String   @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId    String   @default(dbgenerated("current_setting('app.company_id'::text)"))
  kind         String
  listId       String
  name         String
  fullName     String
  parentListId String?
  sublevel     Int      @default(0)
  active       Boolean  @default(true)
  detail       String?
  seenAt       DateTime @default(now())

  @@unique([companyId, kind, listId])
  @@index([companyId])
}

/// A phone or computer that gets notifications for someone (the installed app, or a browser they
/// allowed). Removed when the device says it's gone, or they turn notifications off on it.
model PushDevice {
  id         String    @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId  String    @default(dbgenerated("current_setting('app.company_id'::text)"))
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String
  p256dh     String
  auth       String
  // What kind of device ("iPhone", "Android", "Windows"…), to tell them apart.
  label      String?
  createdAt  DateTime  @default(now())
  lastSentAt DateTime?

  @@unique([companyId, endpoint])
  @@index([companyId])
  @@index([userId])
}

/// QuickBooks Online, connected through Intuit (Settings → QuickBooks). A company has this or the
/// Desktop connection (QbConnection), not both. Tokens are sealed (src/lib/secret-box.ts).
model QboConnection {
  id               String    @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId        String    @unique @default(dbgenerated("current_setting('app.company_id'::text)"))
  // The QuickBooks company (Intuit's realmId) — tied to one builder only.
  realmId          String    @unique
  qbCompany        String?
  accessToken      String
  accessExpiresAt  DateTime
  refreshToken     String
  refreshExpiresAt DateTime?
  connectedById    String?
  // The QuickBooks item invoice lines go out on.
  invoiceItemId    String?
  // Bills and payments are read as changed since this (empty: the last 12 months, from scratch).
  changesSince     DateTime?
  lastSyncAt       DateTime?
  lastError        String?
  // What the last update did ("3 bills, 1 payment").
  lastSummary      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

/// A QuickBooks Online bill or payment as last read (data: what's needed of it, JSON). appliedKey:
/// what was last put into The Builder Station from it — when it no longer matches, it's put in again.
model QbTxn {
  id         String   @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId  String   @default(dbgenerated("current_setting('app.company_id'::text)"))
  kind       String // BILL | PAYMENT
  txnId      String
  txnDate    DateTime
  data       String
  appliedKey String?
  seenAt     DateTime @default(now())

  @@unique([companyId, kind, txnId])
  @@index([companyId])
}

/// A position on the team (Project manager, Estimator…): what its people see and change, area
/// by area (JSON; src/lib/access.ts). Admins aren't a position — they get everything.
model Position {
  id        String   @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId String   @default(dbgenerated("current_setting('app.company_id'::text)"))
  name      String
  // The starting position it came from (STAFF, PM, OFFICE, ESTIMATOR); null = one you made.
  key       String?
  access    String
  sortOrder Int      @default(0)
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

/// Someone on a job's team (besides its manager).
model ProjectMember {
  id        String   @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId String   @default(dbgenerated("current_setting('app.company_id'::text)"))
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([companyId])
  @@index([userId])
}

/// A sub or vendor picked to see a job's location (and directions to it) in their portal.
model ProjectVendor {
  id        String   @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId String   @default(dbgenerated("current_setting('app.company_id'::text)"))
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, vendorId])
  @@index([companyId])
  @@index([vendorId])
}

// ---------------------------------------------------------------------------
// The Builder Station itself — not any builder company
// ---------------------------------------------------------------------------

/// Someone who runs The Builder Station: its owner, or an employee. Not a builder's login — they
/// sign in at /station (src/lib/station-auth.ts), belong to no company, and the app's own database
/// login can't read these rows at all (tenant-rules.ts). role: OWNER | STAFF
model StationUser {
  id             String       @id @default(cuid())
  email          String       @unique
  name           String
  role           String       @default("STAFF")
  passwordHash   String? // null until they set one from their invitation link
  active         Boolean      @default(true)
  sessionVersion Int          @default(0) // bumped to sign them out everywhere
  totpSecret     String? // the authenticator app's secret, encrypted (two-step is required here)
  totpEnabledAt  DateTime?
  backupCodes    String? // JSON: hashes of unused one-time backup codes
  lastSignInAt   DateTime?
  createdAt      DateTime     @default(now())
  log            StationLog[]
}

/// What happened at The Builder Station, and who did it: invitations sent, people added or removed,
/// sign-ins — and the website's requests for an invitation (no one). Read on the Station's Log.
model StationLog {
  id            String       @id @default(cuid())
  stationUserId String?
  stationUser   StationUser? @relation(fields: [stationUserId], references: [id], onDelete: SetNull)
  // e.g. "invite.sent", "invite.requested", "staff.added", "sign-in", "builder.status"
  type          String
  description   String
  // The builder company it was about, if any (a plain id: the history stays if the company goes).
  builderId     String?
  createdAt     DateTime     @default(now())

  @@index([type, createdAt])
  @@index([builderId])
}

/// What The Builder Station keeps about a builder company: where they stand (status: TRIAL | ACTIVE |
/// FREE | PAUSED — no row is Active) and the Station's private notes. The Station's, not the company's:
/// never in the company's backups or exports, and the app's own login can't read it (tenant-rules.ts).
/// PAUSED stops everyone in that company signing in (their data is kept).
model StationBuilder {
  id          String    @id @default(cuid())
  companyId   String    @unique
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status      String    @default("ACTIVE")
  trialEndsAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// A claim on a piece of background work — the nightly backup, a morning's emails, reworking a job's
/// lines — so only one copy of the app does it at a time (job-lock.ts). A claim runs out at `until`,
/// so a copy that stops mid-way doesn't hold it forever. The Builder Station's own, like the Station's
/// tables: no company's, closed to the app's login.
model JobLock {
  name   String   @id
  holder String
  until  DateTime
  at     DateTime @default(now())
}

/// Tries that went wrong (a password, a code, a form) per key, in a time window — shared by every copy
/// of the app (rate-limit.ts). The Builder Station's own: no company's, closed to the app's login.
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

/// A problem someone on a builder's team sent with "Report a problem" (top bar), read on the Station's
/// Problems tab (src/lib/problems.ts). The Station's own: closed to the app's login. `builderId` and
/// `userId` are plain ids, so the report stays if the company goes.
model StationProblem {
  id          String    @id @default(cuid())
  builderId   String?
  builderName String
  userId      String?
  userName    String
  userEmail   String
  page        String
  message     String
  // A picture they added (made smaller, a JPEG).
  screenshot  Bytes?
  // What they were using: the browser and the screen's size.
  device      String?
  doneAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([doneAt, createdAt])
}

/// How builders use the program, for the Station's Builders pages (src/lib/usage.ts): which person, on
/// which day (the builder's clock), in which part of it, how many times. Counts only — never what's on
/// the page. The Station's own: closed to the app's login. `builderId` and `userId` are plain ids.
model StationUsage {
  id        String   @id @default(cuid())
  builderId String
  userId    String
  // ADMIN | STAFF | CLIENT | VENDOR
  role      String
  // yyyy-mm-dd
  day       String
  // "Takeoff", "Estimates", "Client portal"… (usage-areas.ts)
  area      String
  count     Int      @default(1)
  lastAt    DateTime @default(now())

  @@unique([builderId, userId, day, area])
  @@index([builderId, day])
}

/// Something in the program that broke — on the server or in someone's browser — read on the Station's
/// Problems tab, and emailed to the Station's owner (src/lib/problems.ts). The same error again is the
/// same row, counted: `key` is what it is and where it happened.
model StationError {
  id              String    @id @default(cuid())
  key             String    @unique
  // "server" | "browser"
  side            String
  message         String
  stack           String?
  page            String
  count           Int       @default(1)
  // The last one it happened to (plain ids, like the log's).
  lastUserName    String?
  lastBuilderName String?
  lastBuilderId   String?
  firstAt         DateTime  @default(now())
  lastAt          DateTime  @default(now())
  // When the owner was last emailed about it (at most every few hours).
  alertedAt       DateTime?
  // Marked fixed on the Station; happening again opens it again.
  fixedAt         DateTime?

  @@index([fixedAt, lastAt])
}

// ---------------------------------------------------------------------------
// Warranty (after move-in: the client reports it, you send someone, it's fixed)
// ---------------------------------------------------------------------------

/// Something to fix on a finished house (src/lib/warranty.ts). From the client's portal, or
/// added by the team from a phone call. status: NEW | SCHEDULED | DONE | NOT_COVERED.
model WarrantyRequest {
  id           String    @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId    String    @default(dbgenerated("current_setting('app.company_id'::text)"))
  // Counted up across the company: W-1, W-2…
  number       Int
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  // Where in the house ("Master bath").
  location     String?
  // Can't wait: water, no heat, safety.
  urgent       Boolean   @default(false)
  status       String    @default("NEW")
  // Who's fixing it: a sub (sees it in their portal), and/or someone on the team.
  vendorId     String?
  vendor       Vendor?   @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  assigneeId   String?
  assignee     User?     @relation("WarrantyAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  scheduledFor DateTime?
  // Done or not covered: when, and what was done (or why not) — the client sees it.
  closedAt     DateTime?
  closeNote    String?
  // Reported by the client in their portal (else added by the team).
  fromClient   Boolean   @default(false)
  createdById  String?
  createdBy    User?     @relation("WarrantyCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  notes WarrantyNote[]
  files FileAsset[]

  @@unique([companyId, number])
  @@index([companyId])
}

/// A note on a warranty request. `teamOnly`: the client doesn't see it (a sub's notes are team-only).
model WarrantyNote {
  id        String          @id @default(cuid())
  // The company this belongs to (filled in by the program; see src/lib/tenant.ts).
  companyId String          @default(dbgenerated("current_setting('app.company_id'::text)"))
  requestId String
  request   WarrantyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?           @relation("WarrantyNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  teamOnly  Boolean         @default(false)
  createdAt DateTime        @default(now())

  @@index([companyId])
}
