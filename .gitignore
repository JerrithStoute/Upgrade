# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database & uploads
/prisma/*.db
/prisma/*.db-journal
/uploads
/backups

# local Postgres data (npm run dev starts it)
/.pgdata

# test inbox (emails saved instead of sent on this PC)
/.outbox

# Plans for testing Find walls / Find area (never uploaded)
/test-plans/
