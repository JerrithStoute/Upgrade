# Copy to .env and fill in:  cp .env.example .env

# The app's database login (it only sees one company at a time) and the owner login
# (sign-in, backups, migrations). `npm run dev` starts this local database for you.
DATABASE_URL="postgresql://app_user:local-app@localhost:5433/builderstation"
SYSTEM_DATABASE_URL="postgresql://builder:local@localhost:5433/builderstation"

# Signs login cookies. REQUIRED in production: at least 32 random characters.
# Generate one with:  openssl rand -base64 48
SESSION_SECRET=""

# Locks secrets kept in the database (authenticator-app keys). REQUIRED in production:
# a different 32+ character random string. Don't lose it.
ENCRYPTION_KEY=""

# Links in emails point here. Online: https://thebuilderstation.com
APP_URL="http://localhost:3000"
# outbox = save emails to view at /dev/outbox (nothing sent). resend = really send (online).
MAIL="outbox"
# RESEND_API_KEY=""
# MAIL_FROM="The Builder Station <no-reply@thebuilderstation.com>"

# Where uploaded files and photos are stored. Persist this folder between deploys.
UPLOAD_DIR="./uploads"

# Backups (each company's records + its files), taken nightly by the server and by `npm run backup`.
# Point this at a different drive or a synced cloud folder. Default ./backups
BACKUP_DIR="./backups"
# How many database backups to keep (default 30). BACKUP_AUTO="off" stops the nightly backup.
BACKUP_KEEP="30"

# --- Online only (set in Render; see render.yaml and GOING-ONLINE.md) ---
# STORAGE="cloud"
# S3_ENDPOINT="https://<account id>.r2.cloudflarestorage.com"
# S3_BUCKET="builderstation-files"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# TURNSTILE_SITE_KEY=""
# TURNSTILE_SECRET_KEY=""
# TZ="America/Chicago"
