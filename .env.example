# Copy to .env and fill in:  cp .env.example .env

# SQLite database file, relative to the prisma/ folder.
DATABASE_URL="file:./dev.db"

# Signs login cookies. REQUIRED in production: at least 32 random characters.
# The server refuses to start in production without it.
# Generate one with:  openssl rand -base64 48
SESSION_SECRET=""

# Where uploaded files and photos are stored. Persist this folder between deploys.
UPLOAD_DIR="./uploads"
